{
  "multipart": [
    { "when": { "north": "true" }, "apply": { "model": "survivalpoints:block/camp_barbed_wire_side" } },
    { "when": { "east": "true" }, "apply": { "model": "survivalpoints:block/camp_barbed_wire_side", "y": 90 } },
    { "when": { "south": "true" }, "apply": { "model": "survivalpoints:block/camp_barbed_wire_side", "y": 180 } },
    { "when": { "west": "true" }, "apply": { "model": "survivalpoints:block/camp_barbed_wire_side", "y": 270 } },
    { "when": { "north": "false", "east": "false", "south": "false", "west": "false" },
      "apply": { "model": "survivalpoints:block/camp_barbed_wire_post" } }
  ]
}
