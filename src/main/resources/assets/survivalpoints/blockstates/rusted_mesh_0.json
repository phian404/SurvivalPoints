    { "when": { "axis": "x", "east": "true", "mesh_above": "true", "mesh_below": "false" }, "apply": { "model": "survivalpoints:block/rusted_mesh_0_tongue_bottom", "y": 90 } },
    { "when": { "axis": "x", "west": "true", "mesh_above": "true", "mesh_below": "false" }, "apply": { "model": "survivalpoints:block/rusted_mesh_0_tongue_bottom", "y": 270 } },

    { "when": { "axis": "z", "north": "true", "mesh_above": "false", "mesh_below": "true" }, "apply": { "model": "survivalpoints:block/rusted_mesh_0_tongue_top" } },
    { "when": { "axis": "z", "south": "true", "mesh_above": "false", "mesh_below": "true" }, "apply": { "model": "survivalpoints:block/rusted_mesh_0_tongue_top", "y": 180 } },
    { "when": { "axis": "x", "east": "true", "mesh_above": "false", "mesh_below": "true" }, "apply": { "model": "survivalpoints:block/rusted_mesh_0_tongue_top", "y": 90 } },
    { "when": { "axis": "x", "west": "true", "mesh_above": "false", "mesh_below": "true" }, "apply": { "model": "survivalpoints:block/rusted_mesh_0_tongue_top", "y": 270 } },

    { "when": { "axis": "z", "north": "true", "mesh_above": "true", "mesh_below": "true" }, "apply": { "model": "survivalpoints:block/rusted_mesh_0_tongue_middle" } },
    { "when": { "axis": "z", "south": "true", "mesh_above": "true", "mesh_below": "true" }, "apply": { "model": "survivalpoints:block/rusted_mesh_0_tongue_middle", "y": 180 } },
    { "when": { "axis": "x", "east": "true", "mesh_above": "true", "mesh_below": "true" }, "apply": { "model": "survivalpoints:block/rusted_mesh_0_tongue_middle", "y": 90 } },
    { "when": { "axis": "x", "west": "true", "mesh_above": "true", "mesh_below": "true" }, "apply": { "model": "survivalpoints:block/rusted_mesh_0_tongue_middle", "y": 270 } }
