{
  "multipart": [
    { "when": { "north": "true" }, "apply": { "model": "survivalpoints:block/camp_fence_mesh" } },
    { "when": { "east": "true" }, "apply": { "model": "survivalpoints:block/camp_fence_mesh", "y": 90 } },
    { "when": { "south": "true" }, "apply": { "model": "survivalpoints:block/camp_fence_mesh", "y": 180 } },
    { "when": { "west": "true" }, "apply": { "model": "survivalpoints:block/camp_fence_mesh", "y": 270 } },
    { "when": { "north": "true", "east": "false", "south": "false", "west": "false" },
      "apply": { "model": "survivalpoints:block/camp_fence_post_ends" } },
    { "when": { "north": "false", "east": "true", "south": "false", "west": "false" },
      "apply": { "model": "survivalpoints:block/camp_fence_post_ends", "y": 90 } },
    { "when": { "north": "false", "east": "false", "south": "true", "west": "false" },
      "apply": { "model": "survivalpoints:block/camp_fence_post_ends", "y": 180 } },
    { "when": { "north": "false", "east": "false", "south": "false", "west": "true" },
      "apply": { "model": "survivalpoints:block/camp_fence_post_ends", "y": 270 } },
    { "when": { "north": "false", "east": "false", "south": "false", "west": "false" },
      "apply": { "model": "survivalpoints:block/camp_fence_post_center" } }
  ]
}
